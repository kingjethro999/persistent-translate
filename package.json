{
  "name": "persistent-translate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Translate once; stay translated across a website.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev:chrome": "node init && wxt -b chrome",
    "dev:firefox": "node init && wxt -b firefox --mv3",
    "build:chrome": "node init && wxt build -b chrome --mv3",
    "build:firefox": "node init && wxt build -b firefox --mv3",
    "zip:chrome": "wxt zip -b chrome --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e:chrome": "playwright test",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --warnings-as-errors",
    "verify:manifests": "node scripts/verify-manifests.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
